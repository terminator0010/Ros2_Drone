<?xml version="1.0"?>
<PropertyList>
 <generic>
  <output>
   <line_separator>newline</line_separator>
   <var_separator>,</var_separator>
   
   <chunk>
    <name>Ground Elevation</name>
    <node>/position/ground-elev-m</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>
   
   <chunk>
    <name>Rudder Control</name>
    <node>/controls/flight/rudder</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>

   <chunk>
    <name>Aileron Control</name>
    <node>/controls/flight/aileron</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>

   <chunk>
    <name>Elevator Control</name>
    <node>/controls/flight/elevator</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>


   <chunk>
    <name>Throttle Control</name>
    <node>/controls/flight/throttle</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>

   <chunk>
    <name>Flaps Control</name>
    <node>/controls/flight/flaps</node>
    <type>float</type>
    <format>%f\n</format>
   </chunk>

  </output>
 </generic>
</PropertyList>
